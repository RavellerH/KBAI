# Copy this file to .env and fill in real values before running setup.sh
# .env is gitignored — never commit the real file.

# VPS public IP or domain name (used in Nginx config)
DOMAIN=your-vps-ip-or-domain.example.com

# Secret key for Open WebUI session signing (any random string, min 32 chars)
WEBUI_SECRET_KEY=change_me_to_a_random_32_char_string

# Bearer token clients must send to reach the Ollama API via Nginx
# Example:  Authorization: Bearer <this value>
HERMES_API_KEY=change_me_to_your_api_key

# Telegram bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your Telegram chat ID — send /start to the bot to get it, then paste here
TELEGRAM_ALLOWED_CHAT_ID=

# OpenRouter API key for cloud model routing (Claude, GPT-4o, Gemini, etc.)
# Get one at https://openrouter.ai — optional, local Hermes works without it
OPENROUTER_API_KEY=

# AnythingLLM API key for Telegram file-to-knowledge-base uploads
# Generate in AnythingLLM → Settings → API Keys
ANYTHINGLLM_API_KEY=
