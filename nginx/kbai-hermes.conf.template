# Nginx config template for KBAI Hermes Agent
# Variables replaced by setup.sh via envsubst: DOMAIN, HERMES_API_KEY

map $http_authorization $ollama_api_auth {
    default     0;
    "Bearer ${HERMES_API_KEY}" 1;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Open WebUI — handles its own login/user management
    location / {
        proxy_pass          http://127.0.0.1:3000;
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection "upgrade";
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        client_max_body_size 20m;
    }

    # Ollama REST API — requires Bearer token from .env HERMES_API_KEY
    location /api/ {
        if ($ollama_api_auth = 0) {
            return 401;
        }

        proxy_pass          http://127.0.0.1:11434/api/;
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        client_max_body_size 100m;
    }
}
