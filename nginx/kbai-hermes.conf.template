# Nginx config template for KBAI Hermes Agent
# Variables replaced by setup.sh via envsubst: DOMAIN, HERMES_API_KEY
# map_hash_bucket_size is set separately in /etc/nginx/conf.d/map-hash.conf

map $http_authorization $ollama_api_auth {
    default     0;
    "Bearer ${HERMES_API_KEY}" 1;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Open WebUI — all traffic including /api/ routes here so Open WebUI's
    # own backend API is not intercepted by the Ollama proxy block below.
    location / {
        proxy_pass          http://127.0.0.1:3001;
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection "upgrade";
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        client_max_body_size 20m;
    }

    # Ollama REST API at /ollama/ — requires Bearer token from .env HERMES_API_KEY
    # Example: curl http://your-domain/ollama/api/generate -H "Authorization: Bearer <key>"
    location /ollama/ {
        if ($ollama_api_auth = 0) {
            return 401;
        }

        proxy_pass          http://127.0.0.1:11434/;
        proxy_set_header    Host $host;
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        client_max_body_size 100m;
    }
}
