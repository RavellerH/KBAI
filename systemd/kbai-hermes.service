[Unit]
Description=KBAI — Self-hosted Knowledge Base AI (Ollama + Open WebUI + AnythingLLM)
Documentation=https://github.com/ravellerh/kbai
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/kbai
EnvironmentFile=/opt/kbai/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
